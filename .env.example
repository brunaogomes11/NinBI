# Copie para .env (ao lado do docker-compose.yml) antes do `docker compose up`.

# Chave que cifra as senhas das conexões Neo4j guardadas no PostgreSQL.
# Obrigatória: o compose não sobe sem ela. Use uma chave própria de 32 bytes em base64:
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Guarde a chave com o backup do banco: sem ela as senhas guardadas não se decifram.
NINBI_ENCRYPTION_KEY=
