    "infra:down": "node scripts/docker.mjs down",
    "smoke": "node scripts/smoke-compose.mjs",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "sharp": "^0.35.5"
  }
}
